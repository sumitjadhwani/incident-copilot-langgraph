# Copy to .env and fill in. Never commit .env.

# --- LLM ---------------------------------------------------------------
# Provider: deepseek | google_genai
COPILOT_LLM_PROVIDER=deepseek
# Leave empty for the provider default (deepseek-flash / gemini-2.5-flash)
COPILOT_LLM_MODEL=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# --- Postgres (matches infra/docker-compose.yml) -----------------------
COPILOT_DATABASE_URL=postgresql://copilot:copilot@localhost:5432/copilot

# --- LangSmith tracing (optional) --------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=incident-copilot
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
