{
  "id": "oomkilled_loop",
  "title": "checkout-api stuck in an OOMKilled restart loop",
  "description": "A recent release added an in-process product cache. Under normal traffic the container's memory grows past its 256Mi limit within minutes, the kernel OOM-kills it (exit 137), and the pod enters CrashLoopBackOff.",
  "alert": {
    "name": "KubePodCrashLooping",
    "severity": "critical",
    "namespace": "acme-prod",
    "service": "checkout-api",
    "summary": "Pod acme-prod/checkout-api-7d9f8b6c5-x2k4p is restarting frequently (14 restarts in the last 60 minutes).",
    "started_at": "2026-11-21T09:12:00Z",
    "labels": {"team": "payments", "tenant": "acme"}
  },
  "expected": {
    "root_cause_category": "oom",
    "root_cause_keywords": ["OOMKilled", "memory limit", "256Mi"],
    "acceptable_actions": ["patch_resources", "rollback_deployment", "set_env"],
    "action_target": "checkout-api",
    "required_tools": ["describe_pod", "get_pod_logs"],
    "max_tool_calls": 60
  },
  "remediation": {
    "fixes": [
      {"tool": "patch_resources", "args": {"deployment": "checkout-api", "memory_limit": {"min_mib": 384}}},
      {"tool": "rollback_deployment", "args": {"deployment": "checkout-api", "to_revision": 41}},
      {"tool": "set_env", "args": {"deployment": "checkout-api", "name": "PRODUCT_CACHE_MAX_ITEMS", "value": {"max_int": 20000}}},
      {"tool": "set_env", "args": {"deployment": "checkout-api", "name": "PRODUCT_CACHE_ENABLED", "value": "false"}}
    ],
    "heals": ["checkout-api"]
  },
