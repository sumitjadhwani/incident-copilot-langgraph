{
  "id": "db_unreachable",
  "title": "catalog-api down because its database was scaled to zero",
  "description": "During overnight storage maintenance someone scaled the catalog-db deployment to 0 replicas and never scaled it back. catalog-api pods are running but cannot connect to Postgres, fail readiness, and every request returns 503.",
  "alert": {
    "name": "KubeDeploymentReplicasMismatch",
    "severity": "critical",
    "namespace": "acme-prod",
    "service": "catalog-api",
    "summary": "Deployment acme-prod/catalog-api has 0 of 3 replicas ready; catalog-api error rate is 100%.",
    "started_at": "2026-11-21T03:12:00Z",
    "labels": {
      "team": "catalog",
      "tenant": "acme"
    }
  },
  "expected": {
    "root_cause_category": "dependency_down",
    "root_cause_keywords": [
      "catalog-db",
      "scaled",
      "0 replicas",
      "connection refused"
    ],
    "acceptable_actions": [
      "scale_deployment"
    ],
    "action_target": "catalog-db",
    "required_tools": [
      "get_pod_logs"
    ],
    "max_tool_calls": 60
  },
  "remediation": {
    "fixes": [
      {
        "tool": "scale_deployment",
        "args": {
          "deployment": "catalog-db",
          "replicas": {
            "min_int": 1
          }
        }
      }
    ],
    "heals": [
      "catalog-db",
      "catalog-api"
    ]
  },
