{
  "id": "bad_env_var",
  "title": "notification-svc crash loop after a bad SMTP_PORT value",
  "description": "Revision 12 moved SMTP settings into environment variables and set SMTP_PORT to 'smtp.acme.local:587' (host and port pasted together). The service validates config at startup, exits with code 1, and loops in CrashLoopBackOff. Revision 11 was healthy.",
  "alert": {
    "name": "KubePodCrashLooping",
    "severity": "warning",
    "namespace": "acme-prod",
    "service": "notification-svc",
    "summary": "Pods of acme-prod/notification-svc are restarting frequently (9 restarts in 20 minutes).",
    "started_at": "2026-11-21T12:05:00Z",
    "labels": {"team": "messaging", "tenant": "acme"}
  },
  "expected": {
    "root_cause_category": "bad_config",
    "root_cause_keywords": ["SMTP_PORT", "smtp.acme.local:587", "revision 12"],
    "acceptable_actions": ["set_env", "rollback_deployment"],
    "action_target": "notification-svc",
    "required_tools": ["get_pod_logs"],
    "max_tool_calls": 60
  },
  "remediation": {
    "fixes": [
      {"tool": "set_env", "args": {"deployment": "notification-svc", "name": "SMTP_PORT", "value": "587"}},
      {"tool": "rollback_deployment", "args": {"deployment": "notification-svc", "to_revision": 11}}
    ],
    "heals": ["notification-svc"]
  },
