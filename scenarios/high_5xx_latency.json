{
  "id": "high_5xx_latency",
  "title": "orders-api 5xx and latency spike caused by a saturated inventory-api",
  "description": "A marketing campaign roughly doubled order traffic. orders-api scaled out via HPA, but its dependency inventory-api did not: its two pods are pinned at their 250m CPU limit, requests queue up, readiness probes time out, and orders-api returns 504s after a 2s upstream timeout.",
  "alert": {
    "name": "HighErrorRate",
    "severity": "critical",
    "namespace": "acme-prod",
    "service": "orders-api",
    "summary": "orders-api is returning 5xx for 8.9% of requests (SLO 1%) and p99 latency is 2.4s.",
    "started_at": "2026-11-21T11:40:00Z",
    "labels": {"team": "commerce", "tenant": "acme"}
  },
  "expected": {
    "root_cause_category": "cpu_saturation",
    "root_cause_keywords": ["inventory-api", "CPU", "timeout"],
    "acceptable_actions": ["scale_deployment", "patch_resources"],
    "action_target": "inventory-api",
    "required_tools": ["get_pod_logs", "query_metrics"],
    "max_tool_calls": 60
  },
  "remediation": {
    "fixes": [
      {"tool": "scale_deployment", "args": {"deployment": "inventory-api", "replicas": {"min_int": 4}}},
      {"tool": "patch_resources", "args": {"deployment": "inventory-api", "cpu_limit": {"min_millicores": 500}}}
    ],
    "heals": ["inventory-api"]
  },
  "namespaces": {
    "acme-prod": {
      "deployments": {
