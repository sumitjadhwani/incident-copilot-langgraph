              "resources": {"requests": {"cpu": "250m", "memory": "256Mi"}, "limits": {"cpu": "1", "memory": "512Mi"}},
              "env": {"INVENTORY_URL": "http://inventory-api.acme-prod.svc.cluster.local:8080", "UPSTREAM_TIMEOUT_MS": "2000"}
            }
